---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { projects, repoUrl, findProject, formatDate, isoDate } from '../data/projects';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const postFor = (repo: string) => posts.find((p) => p.data.repo === repo);
---
<Base>
  <section class="hero" aria-labelledby="intro-title">
    <div>
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> SMALL IDEAS. REAL THINGS.</p>
      <h1 id="intro-title">把想法写成代码，<br />让日常<span>好用一点。</span></h1>
      <p class="hero-description">你好，我是 chilin11。这里放着我做的开源小工具，<br />以及从「不如自己写一个」开始的开发记录。</p>
      <div class="hero-actions">
        <a class="button" href="#projects">探索项目 <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="#articles">读读开发手记 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true"><span class="art-symbol">&lt;/&gt;</span><span class="art-label">BUILD · SHARE · REPEAT</span></div>
  </section>

  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <div class="section-title"><span class="section-number">01 /</span><h2 id="projects-title">精选项目</h2></div>
      <span class="section-note">从一点好奇，到一个能用的作品。</span>
    </div>
    <div class="project-grid">
      {projects.map((p) => {
        const post = postFor(p.repo);
        return (
          <article class:list={['project-card', p.variant]}>
            <div class="project-top">
              <span class="project-icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={p.icon} /></span>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </div>
            <h3><a href={repoUrl(p.repo)}>{p.repo}</a></h3>
            <p>{p.summary}</p>
            {post && <a class="card-post-link" href={`/posts/${post.id}/`}>阅读介绍文章 →</a>}
            <div class="project-meta">
              <span class="language-dot" aria-hidden="true"></span>{p.language}
              {p.stack.map((s) => <><span class="meta-divider">/</span>{s}</>)}
              {p.note && <><span class="meta-divider">/</span>{p.note}</>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section" id="articles" aria-labelledby="articles-title">
    <div class="section-heading">
      <div class="section-title"><span class="section-number">02 /</span><h2 id="articles-title">最新文章</h2></div>
      <span class="section-note">记录过程，也记录取舍。</span>
    </div>
    <div class="article-list">
      {posts.map((post) => (
        <a class:list={['article-row', findProject(post.data.repo)?.variant]} href={`/posts/${post.id}/`}>
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          <div>
            <h3>{post.data.title}</h3>
            <p><span class="row-repo">{post.data.repo}</span> · {post.data.description}</p>
          </div>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="about-strip" id="about" aria-labelledby="about-title">
    <h2 id="about-title">关于这个角落</h2>
    <p>我是 chilin11，喜欢把日常里的小问题变成小工具。在这里分享项目、实现思路和踩过的坑。代码公开，欢迎试用、提 Issue，或者一起把它做得更好。</p>
  </section>
</Base>
