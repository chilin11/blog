---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { projects, projectCategories, GITHUB_URL, repoUrl, findProject, formatDate, isoDate } from '../data/projects';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const postFor = (repo: string) => posts.find((p) => p.data.repo === repo);
const featured = projects.filter((p) => p.featured);
const publicCount = projects.filter((p) => !p.private).length;
const privateCount = projects.length - publicCount;
---
<Base>
  <section class="hero" aria-labelledby="intro-title">
    <div>
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> SMALL IDEAS. REAL THINGS.</p>
      <h1 id="intro-title">把想法写成代码，<br />让日常<span>好用一点。</span></h1>
      <p class="hero-description">你好，我是 chilin11。从日常小工具到 AI 应用，<br class="desktop-break" />这里收集我的项目作品，以及从「不如自己写一个」开始的开发记录。</p>
      <div class="hero-actions">
        <a class="button" href="#projects">探索项目 <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="#articles">读读开发手记 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <aside class="workbench" aria-labelledby="workbench-title">
      <div class="workbench-heading"><span class="mono" id="workbench-title">ON MY WORKBENCH</span><span class="workbench-dots" aria-hidden="true">● ● ●</span></div>
      <p class="workbench-intro">最近在折腾<span> / AI & TOOLS</span></p>
      {featured.map((p, i) => (
        <a class="workbench-project" href={p.private ? `#project-${p.repo}` : repoUrl(p.repo)}>
          <span class="workbench-index">0{i + 1}</span>
          <span><strong>{p.name || p.repo}</strong><small>{p.featuredSummary || p.summary}{p.private && ' · 私有项目'}</small></span>
          <span class="arrow" aria-hidden="true">{p.private ? '↓' : '↗'}</span>
        </a>
      ))}
      <div class="workbench-footer"><span class="status-dot" aria-hidden="true"></span> 从自己的需求出发，持续迭代。</div>
    </aside>
  </section>

  <div class="site-overview" aria-label="站点概览">
    <p><strong>{String(projects.length).padStart(2, '0')}</strong><span>项目作品</span></p>
    <p><strong>{String(posts.length).padStart(2, '0')}</strong><span>开发手记</span></p>
    <a href={GITHUB_URL}>{publicCount} 个公开项目{privateCount > 0 && ` / ${privateCount} 个私有项目`}<span aria-hidden="true"> GitHub ↗</span></a>
  </div>

  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <div class="section-title"><span class="section-number">01 /</span><h2 id="projects-title">项目陈列室</h2></div>
      <a class="section-note" href={`${GITHUB_URL}?tab=repositories`}>全部 GitHub 仓库 ↗</a>
    </div>
    <div class="project-toolbar">
      <div class="project-filters" role="group" aria-label="按类别筛选项目" hidden>
        {projectCategories.map((category) => (
          <button type="button" data-filter={category.id} aria-pressed={category.id === 'all'} aria-controls="project-grid">
            {category.label}<span>{projects.filter((p) => category.id === 'all' || p.category === category.id).length}</span>
          </button>
        ))}
      </div>
      <p class="project-count" aria-live="polite" aria-atomic="true">展示 {projects.length} 个项目</p>
    </div>
    <div class="project-grid" id="project-grid">
      {projects.map((p) => {
        const post = postFor(p.repo);
        return (
          <article class:list={['project-card', p.variant, { featured: p.featured }]} data-category={p.category} id={`project-${p.repo}`}>
            <div class="project-top">
              <span class="project-icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={p.icon} /></span>
              <span class="project-badge">{p.private ? '私有项目' : p.featured ? '近期在做' : projectCategories.find((c) => c.id === p.category)?.label}</span>
            </div>
            <h3>{p.private ? p.name || p.repo : <a href={repoUrl(p.repo)}>{p.name || p.repo}<span class="project-arrow" aria-hidden="true"> ↗</span></a>}</h3>
            <p>{p.summary}</p>
            <div class="project-links">
              {p.private ? <span class="muted">源码暂不公开</span> : <a href={repoUrl(p.repo)} aria-label={`查看 ${p.name || p.repo} 的 GitHub 源码`}>GitHub 源码 ↗</a>}
              {post && <a href={`/posts/${post.id}/`}>开发手记 →</a>}
            </div>
            <div class="project-meta">
              <span class="language-dot" aria-hidden="true"></span>{p.language}
              {p.stack.map((s) => <><span class="meta-divider">/</span>{s}</>)}
            </div>
            {p.note && <div class="project-note">{p.note}</div>}
          </article>
        );
      })}
    </div>
    <p class="projects-footnote">公开项目提供源码入口{privateCount > 0 && '，私有项目仅展示介绍'}，Fork 项目单独标注。更多公开实验在 <a href={`${GITHUB_URL}?tab=repositories`}>GitHub ↗</a>。</p>
  </section>

  <section class="section" id="articles" aria-labelledby="articles-title">
    <div class="section-heading">
      <div class="section-title"><span class="section-number">02 /</span><h2 id="articles-title">开发手记</h2></div>
      <span class="section-note">记录过程，也记录取舍。</span>
    </div>
    <div class="article-list">
      {posts.map((post) => (
        <a class:list={['article-row', findProject(post.data.repo)?.variant]} href={`/posts/${post.id}/`}>
          <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
          <div>
            <h3>{post.data.title}</h3>
            <p><span class="row-repo">{post.data.repo}</span> · {post.data.description}</p>
          </div>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="about-strip" id="about" aria-labelledby="about-title">
    <h2 id="about-title">关于这个角落</h2>
    <p>我是 chilin11，喜欢把日常里的小问题变成小工具，也喜欢让已经好用的开源项目更贴合自己的工作流。在这里分享项目、实现思路和踩过的坑。欢迎试用、提 Issue，或者一起把它做得更好。</p>
  </section>
</Base>

<script>
  const filters = document.querySelector<HTMLDivElement>('.project-filters');
  const cards = [...document.querySelectorAll<HTMLElement>('.project-card')];
  const count = document.querySelector<HTMLParagraphElement>('.project-count');
  if (filters && count) {
    filters.hidden = false;
    filters.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('button[data-filter]') : null;
      if (!button) return;
      const category = button.dataset.filter;
      filters.querySelectorAll('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      cards.forEach((card) => { card.hidden = category !== 'all' && card.dataset.category !== category; });
      count.textContent = `展示 ${cards.filter((card) => !card.hidden).length} 个项目`;
    });
    document.querySelectorAll<HTMLAnchorElement>('.workbench-project[href^="#project-"]').forEach((link) => {
      link.addEventListener('click', () => filters.querySelector<HTMLButtonElement>('[data-filter="all"]')?.click());
    });
  }
</script>
